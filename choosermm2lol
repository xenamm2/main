local function nukeWindUIRoot()
    pcall(function()
        local rg = CoreGui:FindFirstChild("RobloxGui")
        if not rg then return end
        local windui = rg:FindFirstChild("WindUI")
        while windui do
            windui:Destroy()
            windui = rg:FindFirstChild("WindUI")
        end
    end)
    pcall(function()
        local tip = CoreGui:FindFirstChild("ZovlaneLoaderTooltips")
        while tip do
            tip:Destroy()
            tip = CoreGui:FindFirstChild("ZovlaneLoaderTooltips")
        end
    end)
end
