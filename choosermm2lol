local function notify(title, text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = title, Text = text, Duration = 6
        })
    end)
end

local function loadScript(name, url, key)
    task.defer(function()
        notify(name, "Loading...")
        nukeWindUIRoot()
        getgenv().SCRIPT_KEY = key or "KEYLESS"
        local ok, err = pcall(function()
            loadstring(game:HttpGet(url))()
        end)
        if not ok then notify(name, "Failed: " .. tostring(err)) end
    end)
end

