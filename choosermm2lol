local function fetchImageAsset(url, name)
    local req = http_request or request or (syn and syn.request)
    if not (req and writefile and getcustomasset) then return nil end
    local ok, result = pcall(function()
        local res = req({Url = url, Method = "GET", Headers = {
            ["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64)",
            ["Accept"] = "image/png,image/jpeg,image/*",
            ["Cache-Control"] = "no-cache",
        }})
        if not res or not res.Body or #res.Body < 100 then return nil end
        if res.Body:sub(1, 5):lower():find("<!doc") then return nil end
        -- use timestamp in filename to bust getcustomasset cache
        local fileName = "ZovlaneLoader_" .. name .. "_" .. math.floor(tick()) .. ".png"
        writefile(fileName, res.Body)
        return getcustomasset(fileName)
    end)
    if ok and result and result ~= "" then return result end
    return nil
end

