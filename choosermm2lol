        end
    end

    if buttonContainer then
        buttonContainer.Position = UDim2.new(0, imageWidth + 20, buttonContainer.Position.Y.Scale, buttonContainer.Position.Y.Offset)
    end
end)

local function findButtonByLabel(root, label)
    for _, c in ipairs(root:GetDescendants()) do
        if c:IsA("TextButton") then
            for _, gc in ipairs(c:GetDescendants()) do
                if gc:IsA("TextLabel") and gc.Text == label then return c end
            end
        end
    end
    return nil
end

