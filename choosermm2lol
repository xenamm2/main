        target.MouseLeave:Connect(function()
            TweenService:Create(tip,      TweenInfo.new(0.15), {BackgroundTransparency = 1}):Play()
            TweenService:Create(stroke,   TweenInfo.new(0.15), {Transparency = 1}):Play()
            TweenService:Create(tipLabel, TweenInfo.new(0.15), {TextTransparency = 1}):Play()
