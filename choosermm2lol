local function makeTooltip(text)
    local tip = Instance.new("Frame")
    tip.AutomaticSize = Enum.AutomaticSize.XY
    tip.AnchorPoint = Vector2.new(0.5, 1)
    tip.BackgroundColor3 = Color3.fromRGB(25, 18, 40)
    tip.BackgroundTransparency = 1
    tip.Visible = false
    tip.Parent = overlaySG

    local corner = Instance.new("UICorner", tip)
    corner.CornerRadius = UDim.new(0, 10)
    local stroke = Instance.new("UIStroke", tip)
    stroke.Thickness = 1
    stroke.Color = Color3.fromRGB(255, 100, 170)
    stroke.Transparency = 1

    local pad = Instance.new("UIPadding", tip)
    pad.PaddingLeft = UDim.new(0, 10)
    pad.PaddingRight = UDim.new(0, 10)
    pad.PaddingTop = UDim.new(0, 6)
    pad.PaddingBottom = UDim.new(0, 6)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromOffset(180, 0)
    label.AutomaticSize = Enum.AutomaticSize.Y
    label.BackgroundTransparency = 1
    label.Font = Enum.Font.Gotham
    label.TextSize = 12
    label.TextColor3 = Color3.fromRGB(255, 200, 225)
    label.TextTransparency = 1
    label.TextWrapped = true
    label.Text = text
    label.Parent = tip

    return tip, stroke, label
end

local TOOLTIP_TEXT = {
